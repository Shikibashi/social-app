# The env the app is running in e.g. development, testflight, production
EXPO_PUBLIC_ENV=development

# This is the semver release version of the app, pulled from package.json
EXPO_PUBLIC_RELEASE_VERSION=

# This is the commit hash that the current bundle was made from.
EXPO_PUBLIC_BUNDLE_IDENTIFIER=

# Should be formatted YYMMDDHH so that it increases for each build.
EXPO_PUBLIC_BUNDLE_DATE=0

# Public product identity for web builds. The default deployment is branded as
# Plumbline and hosted at plumblines.uk.
EXPO_PUBLIC_BRAND_NAME=Plumbline
EXPO_PUBLIC_PUBLIC_WEB_ORIGIN=https://plumblines.uk

# The log level for the app's logger transports
EXPO_PUBLIC_LOG_LEVEL=debug

# Enable debug logs for specific logger instances
EXPO_PUBLIC_LOG_DEBUG=session

# This deployment's AppView service identity and public read origin.
# Production has no implicit Bluesky AppView fallback.
EXPO_PUBLIC_APPVIEW_SERVICE_DID=
EXPO_PUBLIC_APPVIEW_SERVICE_FRAGMENT=bsky_appview
EXPO_PUBLIC_PUBLIC_APPVIEW_URL=
EXPO_PUBLIC_APPVIEW_DISPLAY_NAME=
EXPO_PUBLIC_APPVIEW_HEALTH_PATH=/xrpc/_health
EXPO_PUBLIC_ALLOW_INSECURE_LOCAL_APPVIEW=1

# This deployment's public starting feed record. The owner and rkey are
# explicit so the app never silently falls back to an invalid placeholder.
# The selected record is queried through the explicitly named public AppView
# provider and remains visible as external provider provenance in the client.
EXPO_PUBLIC_DEFAULT_FEED_OWNER_DID=did:plc:z72i7hdynmk6r22z27h6tvur
EXPO_PUBLIC_DEFAULT_FEED_RKEY=whats-hot

# Account/PDS entryway for login and handle availability. It is not the
# public-read AppView and does not receive AppView service-auth traffic. The
# canonical web and PDS/OAuth route is plumblines.uk; pds.edriffles.us remains
# a compatibility alias during cutover.
EXPO_PUBLIC_ACCOUNT_SERVICE=https://plumblines.uk

# Spaces alpha is disabled by default. Production web activation requires
# both flags; the second flag is an explicit operator acknowledgement for the
# alpha-backed community board and does not make Spaces production-ready.
EXPO_PUBLIC_SPACES_ALPHA_ENABLED=0
EXPO_PUBLIC_SPACES_ALPHA_PRODUCTION_ENABLED=0

# Optional comma-separated labeler DIDs. Empty means no forced app labeler.
EXPO_PUBLIC_DEFAULT_LABELER_DIDS=

# Chat service DID
EXPO_PUBLIC_CHAT_PROXY_DID=

#
#
# Bluesky specific values
#
#

# Bluesky's metrics API
EXPO_PUBLIC_METRICS_API_HOST=

# Growthbook config
EXPO_PUBLIC_GROWTHBOOK_API_HOST=
EXPO_PUBLIC_GROWTHBOOK_CLIENT_KEY=

# Sentry DSN for telemetry
EXPO_PUBLIC_SENTRY_DSN=

# Bitdrift API key. If undefined, Bitdrift will be disabled.
EXPO_PUBLIC_BITDRIFT_API_KEY=

# geolocation web worker URL
GEOLOCATION_DEV_URL=

# live-events web worker URL
LIVE_EVENTS_DEV_URL=

# app-config web worker URL
APP_CONFIG_DEV_URL=
