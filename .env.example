# The env the app is running in e.g. development, testflight, production
EXPO_PUBLIC_ENV=development

# This is the semver release version of the app, pulled from package.json
EXPO_PUBLIC_RELEASE_VERSION=

# This is the commit hash that the current bundle was made from.
EXPO_PUBLIC_BUNDLE_IDENTIFIER=

# Should be formatted YYMMDDHH so that it increases for each build.
EXPO_PUBLIC_BUNDLE_DATE=0

# Public product identity for web builds. The default deployment is neutral
# branded as Social and hosted at social.edriffles.us.
EXPO_PUBLIC_BRAND_NAME=Social
EXPO_PUBLIC_PUBLIC_WEB_ORIGIN=https://social.edriffles.us

# The log level for the app's logger transports
EXPO_PUBLIC_LOG_LEVEL=debug

# Enable debug logs for specific logger instances
EXPO_PUBLIC_LOG_DEBUG=session

# This deployment's AppView service identity and public read origin.
# Production has no implicit Bluesky AppView fallback.
EXPO_PUBLIC_APPVIEW_SERVICE_DID=
EXPO_PUBLIC_APPVIEW_SERVICE_FRAGMENT=bsky_appview
EXPO_PUBLIC_PUBLIC_APPVIEW_URL=
EXPO_PUBLIC_APPVIEW_DISPLAY_NAME=
EXPO_PUBLIC_APPVIEW_HEALTH_PATH=/xrpc/_health
EXPO_PUBLIC_ALLOW_INSECURE_LOCAL_APPVIEW=1

# This deployment's Discover feed record. The owner and rkey are explicit so
# the app never silently imports Bluesky's Discover algorithm.
EXPO_PUBLIC_DEFAULT_FEED_OWNER_DID=
EXPO_PUBLIC_DEFAULT_FEED_RKEY=radlib-discover

# Optional account entryway for login/handle availability only. It is not the
# public-read AppView and does not receive AppView service-auth traffic.
EXPO_PUBLIC_ACCOUNT_SERVICE=https://bsky.social

# Optional comma-separated labeler DIDs. Empty means no forced app labeler.
EXPO_PUBLIC_DEFAULT_LABELER_DIDS=

# Chat service DID
EXPO_PUBLIC_CHAT_PROXY_DID=

#
#
# Bluesky specific values
#
#

# Bluesky's metrics API
EXPO_PUBLIC_METRICS_API_HOST=

# Growthbook config
EXPO_PUBLIC_GROWTHBOOK_API_HOST=
EXPO_PUBLIC_GROWTHBOOK_CLIENT_KEY=

# Sentry DSN for telemetry
EXPO_PUBLIC_SENTRY_DSN=

# Bitdrift API key. If undefined, Bitdrift will be disabled.
EXPO_PUBLIC_BITDRIFT_API_KEY=

# geolocation web worker URL
GEOLOCATION_DEV_URL=

# live-events web worker URL
LIVE_EVENTS_DEV_URL=

# app-config web worker URL
APP_CONFIG_DEV_URL=
