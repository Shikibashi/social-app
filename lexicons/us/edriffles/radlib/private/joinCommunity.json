{
  "lexicon": 1,
  "id": "us.edriffles.radlib.private.joinCommunity",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Join or request membership in a community. Private and invite-only communities require a one-time invite token.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space"],
          "properties": {
            "space": { "type": "string" },
            "inviteToken": { "type": "string", "maxLength": 256 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space", "state"],
          "properties": {
            "space": { "type": "string" },
            "state": { "type": "string", "knownValues": ["requested", "approved", "denied", "removed", "banned"] }
          }
        }
      }
    }
  }
}
