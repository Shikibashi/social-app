{
  "lexicon": 1,
  "id": "us.edriffles.radlib.private.getAccountVisibility",
  "defs": {
    "main": {
      "type": "query",
      "description": "Return the authenticated account's protected-account mode and private space reference.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "visibility", "space"],
          "properties": {
            "did": { "type": "string", "format": "did" },
            "visibility": { "type": "string", "knownValues": ["public", "protected"] },
            "space": { "type": "string" }
          }
        }
      }
    }
  }
}
