{
  "lexicon": 1,
  "id": "us.edriffles.radlib.private.createInvite",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a high-entropy community invite. Only a hash is stored; the token is returned once to the owner.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space"],
          "properties": {
            "space": { "type": "string" },
            "expiresAt": { "type": "string", "format": "datetime" },
            "maxUses": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 1 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space", "token"],
          "properties": {
            "space": { "type": "string" },
            "token": { "type": "string" }
          }
        }
      }
    }
  }
}
