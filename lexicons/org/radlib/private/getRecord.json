{
  "lexicon": 1,
  "id": "org.radlib.private.getRecord",
  "defs": {
    "main": {
      "type": "query",
      "description": "Read an authorized permissioned record. Unauthenticated and unrelated viewers receive not-found behavior and no private metadata.",
      "parameters": {
        "type": "params",
        "required": ["space", "repo", "collection", "rkey"],
        "properties": {
          "space": { "type": "string" },
          "repo": { "type": "string", "format": "did" },
          "collection": { "type": "string", "format": "nsid" },
          "rkey": { "type": "string", "format": "record-key" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space", "repo", "collection", "rkey", "cid", "record"],
          "properties": {
            "space": { "type": "string" },
            "repo": { "type": "string", "format": "did" },
            "collection": { "type": "string", "format": "nsid" },
            "rkey": { "type": "string", "format": "record-key" },
            "cid": { "type": "string", "format": "cid" },
            "record": { "type": "unknown" }
          }
        }
      },
      "errors": [{ "name": "RecordNotFound" }]
    }
  }
}
