{
  "lexicon": 1,
  "id": "org.radlib.private.putRecord",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create or replace a record in a permissioned account or community space. The record is stored outside the public repository and public sequencer.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space", "collection", "rkey", "record"],
          "properties": {
            "space": { "type": "string" },
            "collection": { "type": "string", "format": "nsid" },
            "rkey": { "type": "string", "format": "record-key", "maxLength": 512 },
            "record": { "type": "unknown" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space", "repo", "collection", "rkey", "cid"],
          "properties": {
            "space": { "type": "string" },
            "repo": { "type": "string", "format": "did" },
            "collection": { "type": "string", "format": "nsid" },
            "rkey": { "type": "string", "format": "record-key" },
            "cid": { "type": "string", "format": "cid" }
          }
        }
      }
    }
  }
}
